{
  "name": "@bazaar/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Bazaar P2P marketplace API (generated from spec/openapi.yaml)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "openapi-ts",
    "spec:lint": "redocly lint ../../spec/openapi.yaml",
    "check:version": "node scripts/check-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests tests/unit",
    "test:contract": "vitest run tests/contract",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@hey-api/openapi-ts": "0.97.3",
    "@redocly/cli": "2.44.2",
    "@types/node": "22.15.0",
    "eslint": "9.29.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vitest": "3.2.6"
  }
}
