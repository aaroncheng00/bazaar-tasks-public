+    )
+
+
+def _get_r2_client():
+    try:
+        import boto3
+
+        endpoint = os.getenv("R2_ENDPOINT")
+        access_key = os.getenv("R2_ACCESS_KEY_ID")
+        secret_key = os.getenv("R2_SECRET_ACCESS_KEY")
+        if not endpoint:
+            return None
+        return boto3.client(
+            "s3",
+            endpoint_url=endpoint,
+            aws_access_key_id=access_key,
+            aws_secret_access_key=secret_key,
+            region_name="auto",
+        )
+    except Exception:
+        return None
+
+
+async def _store_pending(app_id: str, image_key: str, body: ImageUploadRequest) -> None:
+    redis = get_redis()
+    meta = {
+        "app_id": app_id,
+        "image_key": image_key,
+        "content_type": body.content_type,
+        "content_length": body.content_length,
+        "acting_user_id": body.acting_user_id,
+        "created_at": datetime.now(timezone.utc).isoformat(),
+    }
+    await redis.set(f"pending_image:{app_id}:{image_key}", json.dumps(meta), ex=86400 * 2)
+
+
+async def _get_pending(app_id: str, image_key: str):
+    redis = get_redis()
+    raw = await redis.get(f"pending_image:{app_id}:{image_key}")
+    if raw is None:
+        return None
+    try:
+        return json.loads(raw)
+    except Exception:
+        return None
