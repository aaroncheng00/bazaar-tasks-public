+
+def _sanitize_ref(ref: str) -> str:
+    truncated = ref[:50] if len(ref) > 50 else ref
+    return _CONTROL_RE.sub("?", truncated)
+
+
+def _parse_listing_id(listing_ref: str) -> uuid.UUID:
+    safe_ref = _sanitize_ref(listing_ref)
+    not_found = ApiError(
+        status.HTTP_404_NOT_FOUND,
+        LISTING_NOT_FOUND,
+        f"No listing {safe_ref} for this app.",
+    )
+    if not listing_ref or len(listing_ref) > MAX_LISTING_ID_LEN:
+        raise not_found
+    if not listing_ref.startswith("lst_"):
+        raise not_found
+    try:
+        return uuid.UUID(listing_ref[4:])
+    except ValueError:
+        raise not_found from None
+
+
+def _require_seller(row: DbListing, acting_user_id: str) -> None:
+    if row.seller_user_id != acting_user_id:
+        raise ApiError(
+            status.HTTP_403_FORBIDDEN,
+            SELLER_ONLY,
+            "acting_user_id does not match the listing's seller_user_id.",
+        )
+
+
+def _validate_upload_request(body: ImageUploadRequest) -> None:
+    if not body.acting_user_id or len(body.acting_user_id) > MAX_USER_ID_LEN:
+        raise ApiError(
+            status.HTTP_400_BAD_REQUEST,
+            VALIDATION_FAILED,
+            "acting_user_id too long or empty",
+        )
+    if body.content_type not in ALLOWED_TYPES:
+        raise ApiError(
+            status.HTTP_400_BAD_REQUEST,
+            VALIDATION_FAILED,
+            f"content_type must be one of {', '.join(ALLOWED_TYPES)}",
+        )
+    if body.content_length <= 0 or body.content_length > MAX_CONTENT_LENGTH:
+        raise ApiError(
+            status.HTTP_400_BAD_REQUEST,
+            VALIDATION_FAILED,
+            "content_length out of bounds",
+        )
+
+
+def _listing_response(row: DbListing) -> Listing:
+    import uuid as _uuid
+
+    try:
+        app_id = _uuid.UUID(row.app_id)
+    except ValueError:
+        try:
+            app_id = _uuid.uuid5(_uuid.NAMESPACE_DNS, row.app_id)
+        except Exception:
+            app_id = _uuid.UUID(int=0)
+
+    from bazaar_api.generated.models import Category, Condition, Currency
+
+    r2_endpoint = os.getenv("R2_ENDPOINT", "http://localhost:9000").rstrip("/")
+    r2_bucket = os.getenv("R2_BUCKET", "bazaar-media")
+    image_keys = list(row.image_keys) if row.image_keys else []
+    image_urls = [f"{r2_endpoint}/{r2_bucket}/{k}" for k in image_keys]
+
+    return Listing(
+        id=f"lst_{row.id}",
+        app_id=app_id,
+        seller_user_id=row.seller_user_id,
+        title=row.title,
+        description=row.description,
+        price_cents=row.price_cents,
+        currency=Currency(row.currency),
+        category=Category(row.category),
+        condition=Condition(row.condition),
+        status=ListingStatus(row.status),
+        lat=row.lat,
+        lng=row.lng,
+        image_keys=image_keys,
+        image_urls=image_urls,
+        buyer_user_id=row.buyer_user_id,
