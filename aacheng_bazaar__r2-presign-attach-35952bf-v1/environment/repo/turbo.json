{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["spec/openapi.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "outputs": ["src/gen/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
