{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // Generated hey-api code (src/gen) is not compatible with
    // exactOptionalPropertyTypes; the check is disabled package-wide rather
    // than hand-editing generated output.
    "exactOptionalPropertyTypes": false,
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "openapi-ts.config.ts"]
}
